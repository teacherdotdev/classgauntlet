# Cloudflare Realtime TURN key, used by api/turn.ts so students on strict school
# networks can still reach the teacher's laptop. Set these in Vercel too.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
# Optional: point at another PeerJS server, e.g. a local one while testing.
# VITE_PEER_HOST=192.168.1.20
# VITE_PEER_PORT=9000
# VITE_PEER_PATH=/peerjs
# VITE_PEER_SECURE=false
# VITE_FORCE_TURN=true
# Cloudflare Web Analytics token, set in Vercel production by the Sites scripts.
# VITE_CF_BEACON_TOKEN=
